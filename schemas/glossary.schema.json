{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Subject glossary: criterion term <- source synonyms (specs/06 §8)",
  "type": "object",
  "required": ["subject", "entries"],
  "properties": {
    "subject": {"type": "string"},
    "entries": {
      "type": "array",
      "items": {"type": "object",
        "required": ["term", "synonyms", "scope", "decision", "added_at"],
        "properties": {
          "term": {"type": "string", "minLength": 2},
          "synonyms": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}},
          "scope": {"type": ["string", "null"], "description": "method id or exam id; null = whole subject"},
          "decision": {"type": "string"},
          "added_at": {"type": "string"}
        },
        "additionalProperties": false}
    }
  },
  "additionalProperties": false
}
