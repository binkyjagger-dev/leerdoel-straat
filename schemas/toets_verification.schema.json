{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ToetsVerification",
  "description": "R/35_verification.json — the fresh toets-verifier's verdicts (specs/34 §5, specs/36 §7: V11 cueing, V12 readability and storyline).",
  "type": "object",
  "required": ["round", "vragen", "toets_findings", "proposed_decisions"],
  "properties": {
    "round": {"type": "integer", "minimum": 1},
    "only": {"type": ["array", "null"], "items": {"type": "string"}},
    "vragen": {"type": "array", "items": {
      "type": "object", "required": ["vraag_id", "verdict", "findings"],
      "properties": {
        "vraag_id": {"type": "string", "pattern": "^O[0-9]+-V[0-9]+$"},
        "verdict": {"enum": ["pass", "repair"]},
        "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
        "bloom_realised": {"type": "array", "items": {"type": "object", "required": ["seq", "bloom"],
                           "properties": {"seq": {"type": "integer"}, "bloom": {"type": "string"}}}},
        "pattern_realised": {"type": ["string", "null"]}
      }}},
    "toets_findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "proposed_decisions": {"type": "array", "items": {"$ref": "#/$defs/proposed_decision"}}
  },
  "$defs": {
    "proposed_decision": {
      "description": "specs/36 §7, §11 B18: in the format decisions.py add takes (as intake questions); applies_to = roles of schemas/decisions.schema.json (the toets fixture checks the two lists are equal), impact high|medium|low; vraag ids and knob names go in affects_units / context, never in applies_to",
      "type": "object", "required": ["question", "context", "options", "proposed", "impact", "applies_to"],
      "properties": {
        "question": {"type": "string", "minLength": 10},
        "context": {"type": "string"},
        "options": {"type": "array", "minItems": 2, "maxItems": 4, "items": {"type": "string"}},
        "proposed": {"type": "string"},
        "impact": {"enum": ["high", "medium", "low"]},
        "applies_to": {"type": "array", "minItems": 1, "items": {"enum": ["ingest", "planner", "generator", "student-language", "verifier", "exporter", "method-ingest", "mapping-judge", "exercise-judge", "mapping-verifier", "exam-ingest", "exam-judge", "item-labeller", "catalogue"]}},
        "affects_units": {"type": ["array", "null"], "items": {"type": "string"}},
        "scope": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object", "required": ["id", "severity", "evidence", "fix_hint"],
      "properties": {
        "id": {"enum": ["V1", "V2", "V3", "V4", "V5", "V6", "V7", "V8", "V9", "V10", "V11", "V12"]},
        "vraag_id": {"type": ["string", "null"]},
        "severity": {"enum": ["must", "should"]},
        "evidence": {"type": "string"},
        "fix_hint": {"type": "string"}
      }
    }
  }
}
