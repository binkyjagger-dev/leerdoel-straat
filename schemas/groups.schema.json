{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LearningGoalGroups",
  "type": "object",
  "required": ["groups"],
  "$defs": {
    "bloom": {"enum": ["onthouden", "begrijpen", "toepassen", "analyseren", "evalueren", "creëren"]}
  },
  "properties": {
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["group_id", "unit_id", "source_quote", "goal", "criteria"],
        "properties": {
          "group_id": {"type": "string", "pattern": "^[^\\s]+-[0-9]{2}$"},
          "unit_id": {"type": "string"},
          "source_quote": {"type": "string", "minLength": 10},
          "goal": {
            "type": "object",
            "required": ["text_expert"],
            "properties": {
              "text_expert": {"type": "string", "minLength": 10},
              "text_student": {"type": ["string", "null"]},
              "bloom": {"anyOf": [{"$ref": "#/$defs/bloom"}, {"type": "null"}]}
            }
          },
          "criteria": {
            "type": "array", "minItems": 2, "maxItems": 4,
            "items": {
              "type": "object",
              "required": ["criterion_id", "text_expert", "bloom", "bloom_verb"],
              "properties": {
                "criterion_id": {"type": "string"},
                "text_expert": {"type": "string", "minLength": 10},
                "text_student": {"type": ["string", "null"]},
                "bloom": {"$ref": "#/$defs/bloom"},
                "bloom_verb": {"type": "string", "minLength": 2}
              }
            }
          },
          "provenance": {
            "type": "object",
            "properties": {"generated_round": {"type": "integer"}, "generator_notes": {"type": "string"}}
          },
          "status": {"enum": ["pass", "revise", "reject", null]}
        }
      }
    }
  }
}
