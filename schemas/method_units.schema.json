{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MethodUnits",
  "type": "object",
  "required": ["method", "units"],
  "properties": {
    "method": {
      "type": "object",
      "required": ["method_id", "subject", "title", "files", "text_extraction"],
      "properties": {
        "method_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "subject": {"type": "string"},
        "publisher": {"type": ["string", "null"]},
        "title": {"type": "string"},
        "edition": {"type": ["string", "null"]},
        "level": {"type": ["string", "null"]},
        "volume_order": {"type": ["integer", "null"]},
        "files": {"type": "array", "items": {"type": "string"}},
        "text_extraction": {"enum": ["pdftotext", "ocr", "mixed"]},
        "ocr_pages": {"type": ["array", "null"], "items": {"type": "integer"}},
        "ingested_at": {"type": ["string", "null"]}
      }
    },
    "units": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["unit_id", "parent_id", "kind", "code"],
        "properties": {
          "unit_id": {"type": "string", "minLength": 1},
          "parent_id": {"type": ["string", "null"]},
          "kind": {"enum": ["hoofdstuk", "paragraaf", "opgave", "deelvraag"]},
          "code": {"type": "string"},
          "title": {"type": ["string", "null"]},
          "page_from": {"type": ["integer", "null"]},
          "page_to": {"type": ["integer", "null"]},
          "order": {"type": ["integer", "null"]},
          "concepts": {"type": ["array", "null"], "items": {"type": "string"}},
          "text_ref": {"type": ["string", "null"]},
          "answer_ref": {"type": ["string", "null"]}
        }
      }
    }
  }
}
