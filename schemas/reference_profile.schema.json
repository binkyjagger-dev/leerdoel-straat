{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReferenceProfile",
  "description": "subjects/<vak>/examenbank/profiel/referentieprofiel.json (profile_build.py, specs/26 §4), its run copy R/30_reference_profile.json, and the seed subjects/<vak>/toets/seed_profile.json (specs/26 §6). Shares are by points, conditional on applicability. #/$defs/pattern_stats = profiel/patronen_stats.json.",
  "type": "object",
  "required": ["subject", "source", "n_exams", "points", "by", "pooled", "unknown_knobs", "exams"],
  "properties": {
    "subject": {"type": "string"},
    "source": {"type": "string", "description": "'bank-labels', 'seed-analysis-…' or 'none'"},
    "label": {"type": ["string", "null"], "description": "Dutch: 'referentie: 2 examens (2025-I, 2026-I)' or 'referentie: voorlopig, analyse nov 2026'"},
    "note": {"type": ["string", "null"]},
    "n_exams": {"type": "integer", "minimum": 0},
    "n_questions": {"type": ["integer", "null"], "minimum": 0},
    "points": {"type": "number", "minimum": 0},
    "by": {"const": "points"},
    "pooled": {"type": "object", "additionalProperties": {"$ref": "#/$defs/knob_shares"}},
    "excluded": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": {"type": "number"}},
                 "description": "knob → reason (disputed, not_applicable, unlinked, nieuw) → points left out, pooled"},
    "unknown_knobs": {"type": "array", "items": {"type": "string"}},
    "house_rules": {"$ref": "#/$defs/house_rules",
                    "description": "specs/36 §3.1: CE house rules from B/metrics/ (profile_build.py) or a seed block; absent = 'geen huisregels gemeten'"},
    "exams": {"type": "array", "items": {
      "type": "object", "required": ["exam_id", "points", "knobs"],
      "properties": {
        "exam_id": {"type": "string"},
        "points": {"type": "number"},
        "n_questions": {"type": "integer"},
        "knobs": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": {"type": "number"}}},
        "excluded": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": {"type": "number"}}},
        "questions": {"type": "array"}
      }}}
  },
  "$defs": {
    "stat3": {"type": "object", "required": ["mean", "min", "max"],
              "properties": {"mean": {"type": "number"}, "min": {"type": "number"}, "max": {"type": "number"}}},
    "pq": {"type": "object", "required": ["p50", "p90"],
           "properties": {"p50": {"type": "number"}, "p90": {"type": "number"}, "empty_share": {"type": "number"}}},
    "house_rules": {
      "type": "object",
      "required": ["source", "n_exams", "exams", "minutes_per_point", "words_per_point", "points_per_opgave",
                   "vragen_per_opgave", "groups_per_point", "groups_per_opgave", "words_task", "words_lead",
                   "numbers_lead", "n_tasks"],
      "properties": {
        "source": {"type": "string", "description": "'bank-metrics' or the seed's source"},
        "label": {"type": ["string", "null"]},
        "n_exams": {"type": "integer", "minimum": 0},
        "exams": {"type": "array", "items": {"type": "string"}},
        "minutes_per_point": {"type": ["number", "null"], "description": "duration / max_score, pooled over exams with a known duration"},
        "words_per_point": {"type": "object", "required": ["pooled", "p25", "p50", "p75"],
                            "properties": {"pooled": {"type": "number"}, "p25": {"type": "number"},
                                           "p50": {"type": "number"}, "p75": {"type": "number"}},
                            "description": "pooled = all words / all points; p25/p50/p75 over opgaven"},
        "points_per_opgave": {"$ref": "#/$defs/stat3"},
        "vragen_per_opgave": {"$ref": "#/$defs/stat3"},
        "groups_per_point": {"type": "object", "required": ["pooled", "max"],
                             "properties": {"pooled": {"type": ["number", "null"]}, "max": {"type": ["number", "null"]}},
                             "description": "distinct groups / points per exam; pooled over exams and the max over exams (O9)"},
        "groups_per_opgave": {"type": "object", "required": ["mean", "max"],
                              "properties": {"mean": {"type": ["number", "null"]}, "max": {"type": ["number", "null"]}}},
        "words_task": {"$ref": "#/$defs/pq"},
        "words_lead": {"$ref": "#/$defs/pq"},
        "numbers_lead": {"$ref": "#/$defs/pq"},
        "n_tasks": {"type": "object", "description": "pattern code → share of vragen with 1, 2, 3+ tasks and max_tasks",
                    "additionalProperties": {
                      "type": "object", "required": ["n_vragen", "shares", "max_tasks"],
                      "properties": {"n_vragen": {"type": "integer"},
                                     "shares": {"type": "object", "additionalProperties": {"type": "number"}},
                                     "max_tasks": {"type": "integer", "minimum": 1}}}},
        "per_exam": {"type": "array", "items": {"type": "object", "required": ["exam_id"]}}
      }
    },
    "knob_shares": {"type": "object", "additionalProperties": {
      "type": "object", "required": ["points", "share"],
      "properties": {"points": {"type": "number", "minimum": 0}, "share": {"type": "number", "minimum": 0, "maximum": 1}}}},
    "pattern_stats": {
      "type": "object", "required": ["subject", "source", "patterns"],
      "properties": {
        "subject": {"type": "string"},
        "source": {"type": "string"},
        "patterns": {"type": "object", "additionalProperties": {
          "type": "object", "required": ["n_questions", "points", "bloom", "solo", "examples"],
          "properties": {
            "n_questions": {"type": "integer"},
            "points": {"type": "object", "required": ["sum", "min", "max"],
                       "properties": {"sum": {"type": "number"}, "min": {"type": "number"}, "max": {"type": "number"}}},
            "bloom": {"type": "object", "additionalProperties": {"type": "number"}},
            "solo": {"type": "object", "additionalProperties": {"type": "number"}},
            "examples": {"type": "array", "items": {
              "type": "object", "required": ["exam_id", "question_number", "example_quality"],
              "properties": {"exam_id": {"type": "string"}, "question_number": {"type": "integer"},
                             "example_quality": {"type": ["string", "null"]}, "reason": {"type": ["string", "null"]},
                             "points": {"type": "number"}}}}
          }}}
      }
    }
  }
}
