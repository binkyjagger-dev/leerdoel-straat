{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mappings",
  "type": "object",
  "required": ["links"],
  "properties": {
    "links": {
      "type": "array",
      "items": {"type": "object",
        "required": ["criterion_id", "group_id", "unit_id", "treatment", "gradation", "quote", "confidence", "judges", "status"],
        "properties": {
          "criterion_id": {"type": "string"}, "group_id": {"type": "string"}, "unit_id": {"type": "string"},
          "treatment": {"enum": ["explains", "practises", "mentions"]},
          "gradation": {"enum": ["leert", "herhaalt", "oefent", "noemt"]},
          "quote": {"type": "string"}, "quote_page": {"type": ["integer", "null"]},
          "confidence": {"enum": ["high", "medium", "low"]},
          "judges": {"type": "object"},
          "verifier": {"type": ["string", "null"]},
          "note": {"type": ["string", "null"]},
          "status": {"enum": ["proposed", "confirmed", "rejected"]}
        }}
    },
    "voided": {"type": "array"},
    "findings": {"type": "array"}
  }
}
