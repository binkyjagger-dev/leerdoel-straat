{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ItemLabels",
  "description": "Pattern and knob labels per question (specs/26 §2, §5; specs/34 §4). Root = one labeller file (R/26_labels.<A|B|R>/<opgave>.json or R/34_labels.<A|B|R>/<opgave>.json). #/$defs/merged = R/26_labels.json or R/34_labels.json (label_merge.py). #/$defs/bank_file = subjects/<vak>/examenbank/labels/<exam_id>.json (bank_labels_add.py).",
  "type": "object",
  "required": [
    "labeller",
    "mode",
    "opgave_id",
    "items"
  ],
  "properties": {
    "labeller": {
      "enum": [
        "A",
        "B",
        "R"
      ]
    },
    "mode": {
      "enum": [
        "exam",
        "toets"
      ]
    },
    "opgave_id": {
      "type": "string"
    },
    "items": {
      "type": "array"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "labeller": {
            "enum": [
              "A",
              "B"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/$defs/label_item"
            }
          }
        }
      },
      "else": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/$defs/repair_item"
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "pattern": {
      "type": "string",
      "pattern": "^([A-Z][0-9]{2}(\\+[A-Z][0-9]{2})?|NIEUW)$"
    },
    "solo": {
      "enum": [
        "unistructureel",
        "multistructureel",
        "relationeel",
        "uitgebreid abstract"
      ]
    },
    "route": {
      "enum": [
        "gegeven",
        "zelf vinden",
        null
      ]
    },
    "steps": {
      "enum": [
        "1",
        "2",
        "3",
        "4+"
      ]
    },
    "sources": {
      "enum": [
        "in vraagtekst",
        "één bron",
        "meerdere bronnen"
      ]
    },
    "yesno": {
      "enum": [
        "nee",
        "ja"
      ]
    },
    "yesno_null": {
      "enum": [
        "nee",
        "ja",
        null
      ]
    },
    "schema_value": {
      "enum": [
        "voorgestructureerd",
        "deels ingevuld",
        null
      ]
    },
    "example_quality": {
      "enum": [
        "goed",
        "bruikbaar",
        "ongeschikt",
        null
      ]
    },
    "level": {
      "enum": [
        "onthouden",
        "begrijpen",
        "toepassen",
        "analyseren",
        "evalueren",
        "creëren",
        null
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "field → verbatim quote ≤ 25 words from the question, a source or the correctievoorschrift"
    },
    "proposed_pattern": {
      "type": "object",
      "required": [
        "name",
        "description",
        "scoring",
        "layer"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "scoring": {
          "type": "string"
        },
        "layer": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "explanation",
            "calculation",
            "schema",
            "drawing",
            "choice"
          ]
        }
      }
    },
    "label_item": {
      "type": "object",
      "required": [
        "question_id",
        "question_number",
        "pattern",
        "solo",
        "route",
        "steps",
        "sources",
        "noise",
        "claim",
        "new_concept",
        "schema",
        "builds_on",
        "builds_on_questions",
        "example_quality",
        "evidence"
      ],
      "properties": {
        "question_id": {
          "type": "string",
          "description": "exam: unit id of the question; toets: vraag_id"
        },
        "question_number": {
          "type": "integer",
          "minimum": 1
        },
        "pattern": {
          "$ref": "#/$defs/pattern"
        },
        "proposed_pattern": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/proposed_pattern"
            }
          ]
        },
        "solo": {
          "$ref": "#/$defs/solo"
        },
        "route": {
          "$ref": "#/$defs/route"
        },
        "steps": {
          "$ref": "#/$defs/steps"
        },
        "sources": {
          "$ref": "#/$defs/sources"
        },
        "noise": {
          "$ref": "#/$defs/yesno"
        },
        "claim": {
          "$ref": "#/$defs/yesno"
        },
        "new_concept": {
          "$ref": "#/$defs/yesno"
        },
        "schema": {
          "$ref": "#/$defs/schema_value"
        },
        "builds_on": {
          "$ref": "#/$defs/yesno_null"
        },
        "builds_on_questions": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "example_quality": {
          "$ref": "#/$defs/example_quality"
        },
        "example_quality_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "points": {
          "type": [
            "integer",
            "null"
          ],
          "description": "ignored (LB6): points come from the units"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "pattern": {
                "const": "NIEUW"
              }
            }
          },
          "then": {
            "required": [
              "proposed_pattern"
            ],
            "properties": {
              "proposed_pattern": {
                "$ref": "#/$defs/proposed_pattern"
              }
            }
          }
        }
      ]
    },
    "repair_item": {
      "type": "object",
      "required": [
        "question_id",
        "evidence",
        "reason"
      ],
      "properties": {
        "question_id": {
          "type": "string"
        },
        "question_number": {
          "type": "integer"
        },
        "pattern": {
          "$ref": "#/$defs/pattern"
        },
        "proposed_pattern": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/proposed_pattern"
            }
          ]
        },
        "solo": {
          "$ref": "#/$defs/solo"
        },
        "route": {
          "$ref": "#/$defs/route"
        },
        "steps": {
          "$ref": "#/$defs/steps"
        },
        "sources": {
          "$ref": "#/$defs/sources"
        },
        "noise": {
          "$ref": "#/$defs/yesno"
        },
        "claim": {
          "$ref": "#/$defs/yesno"
        },
        "new_concept": {
          "$ref": "#/$defs/yesno"
        },
        "schema": {
          "$ref": "#/$defs/schema_value"
        },
        "builds_on": {
          "$ref": "#/$defs/yesno_null"
        },
        "builds_on_questions": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "example_quality": {
          "$ref": "#/$defs/example_quality"
        },
        "example_quality_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "confidence": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "high",
          "medium",
          "disputed"
        ]
      }
    },
    "merged_label": {
      "type": "object",
      "required": [
        "question_id",
        "question_number",
        "opgave_id",
        "points",
        "pattern",
        "solo",
        "route",
        "steps",
        "sources",
        "noise",
        "claim",
        "new_concept",
        "schema",
        "builds_on",
        "builds_on_questions",
        "combination",
        "bloom",
        "example_quality",
        "confidence",
        "evidence"
      ],
      "properties": {
        "exam_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "question_id": {
          "type": "string"
        },
        "question_number": {
          "type": "integer"
        },
        "opgave_id": {
          "type": "string"
        },
        "first_of_opgave": {
          "type": "boolean"
        },
        "points": {
          "type": "integer",
          "minimum": 1
        },
        "pattern": {
          "oneOf": [
            {
              "$ref": "#/$defs/pattern"
            },
            {
              "type": "null"
            }
          ]
        },
        "proposed_pattern": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/proposed_pattern"
            }
          ]
        },
        "solo": {
          "oneOf": [
            {
              "$ref": "#/$defs/solo"
            },
            {
              "type": "null"
            }
          ]
        },
        "route": {
          "$ref": "#/$defs/route"
        },
        "steps": {
          "oneOf": [
            {
              "$ref": "#/$defs/steps"
            },
            {
              "type": "null"
            }
          ]
        },
        "sources": {
          "oneOf": [
            {
              "$ref": "#/$defs/sources"
            },
            {
              "type": "null"
            }
          ]
        },
        "noise": {
          "$ref": "#/$defs/yesno_null"
        },
        "claim": {
          "$ref": "#/$defs/yesno_null"
        },
        "new_concept": {
          "$ref": "#/$defs/yesno_null"
        },
        "schema": {
          "$ref": "#/$defs/schema_value"
        },
        "builds_on": {
          "$ref": "#/$defs/yesno_null"
        },
        "builds_on_questions": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "combination": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "bloom": {
          "$ref": "#/$defs/level"
        },
        "scorepunt_bloom": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "points",
              "bloom"
            ],
            "properties": {
              "points": {
                "type": "integer"
              },
              "bloom": {
                "$ref": "#/$defs/level"
              },
              "group_id": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "example_quality": {
          "$ref": "#/$defs/example_quality"
        },
        "example_quality_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "repaired_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "disagreements": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          }
        }
      }
    },
    "merged": {
      "type": "object",
      "required": [
        "mode",
        "run_id",
        "labels",
        "proposed_patterns"
      ],
      "properties": {
        "mode": {
          "enum": [
            "exam",
            "toets"
          ]
        },
        "run_id": {
          "type": "string"
        },
        "labels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/merged_label"
          }
        },
        "proposed_patterns": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "bank_file": {
      "type": "object",
      "required": [
        "exam_id",
        "criteria_run",
        "run_id",
        "questions"
      ],
      "properties": {
        "exam_id": {
          "type": "string"
        },
        "criteria_run": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "questions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/merged_label"
          }
        }
      }
    }
  }
}
